# Supabase dashboard: Project Settings / Data API
#
# URL must be the PROJECT URL only, with no path:
#   correct   https://YOUR-PROJECT-REF.supabase.co
#   wrong     https://YOUR-PROJECT-REF.supabase.co/rest/v1/
# supabase-js appends /rest/v1 itself.
#
# Both values are safe in the browser; the key is constrained by Row Level
# Security (see supabase/waitlist.sql). Never put a service_role or sb_secret
# key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY
